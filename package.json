{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "rm -rf public/build && vite build",
        "build:push": "rm -rf public/build && vite build && git add -A && git commit -m \"build: update production assets\" && git push origin main",
        "deploy": "npm run build:push"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.3.3",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "flowbite": "^4.0.2",
        "lucide": "^1.34.0",
        "sweetalert2": "^11.26.25"
    }
}

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect all requests into the Laravel public folder.
    # Works when the cPanel document root points to the project root.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory listing
Options -Indexes

# Hide Apache version / technology info
ServerSignature Off
